# --- Pollar ---------------------------------------------------------------
# dashboard.pollar.xyz -> Build -> API Keys
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_xxxxxxxxxxxxxxxxxxxx
# Server only. Never prefix this with NEXT_PUBLIC_.
POLLAR_SECRET_KEY=sec_testnet_xxxxxxxxxxxxxxxxxxxx

# --- Stellar --------------------------------------------------------------
STELLAR_NETWORK=testnet
# Testnet USDC issuer (circle's testnet issuer). Confirm against the asset you
# enabled under Treasury -> Tokens & Trustlines — it must be the same issuer.
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# The corridor's settlement hot wallet. A plain Stellar keypair, funded with
# testnet USDC. Keep it thin; the reserve lives in the operator Pollar wallet.
# Leave blank — `npm run setup:treasury` generates one and prints it here.
TREASURY_SECRET_SEED=
SETTLEMENT_LOW_WATER=250

# --- Nigerian rail --------------------------------------------------------
# sandbox | paystack
NGN_RAIL=sandbox
NGN_PROVIDER_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NGN_PROVIDER_WEBHOOK_SECRET=sandbox-webhook-secret
NGN_PREFERRED_BANK=wema-bank

# --- Corridor -------------------------------------------------------------
# Fixed rate keeps demos reproducible — a judge replaying a receipt sees the
# same numbers. Remove to use the live feed.
NGN_PER_USD_FIXED=1550
DEMO_ASSUMED_TIER=basic
